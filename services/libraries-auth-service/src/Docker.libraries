# Step 1: Use official Node.js image
FROM node:18

# Step 2: Set working directory inside container
WORKDIR /app

# Step 3: Copy package.json and package-lock.json
COPY package*.json ./

# Step 4: Install dependencies
RUN npm install

# Step 5: Copy rest of the application files
COPY . .

# Step 6: Expose the port (same port your service runs on)
EXPOSE 5000

# Step 7: Start the service
CMD ["node", "index.js"]
